+/** Fresh live-progress state for one model. */
+function newLiveModel(model: string): FusionLiveModel {
+	return { model, phase: "queued", chars: 0, thinking_chars: 0, tools: 0, turns: 0, preview: "" };
+}
+
+/** Tail of the streamed text, so the live view shows the newest output rather than the start. */
+function tailPreview(text: string, max = 600): string {
+	const trimmed = text.replace(/\s+$/, "");
+	if (!trimmed) return "";
+	return trimmed.length > max ? "…" + trimmed.slice(-max) : trimmed;
+}
+
+/** Fold one streamed response-so-far into the model's live state. */
+function applyLivePartial(live: FusionLiveModel, partial: AssistantMessage): void {
+	const text = getTextContent(partial);
+	live.chars = text.length;
+	live.preview = tailPreview(text);
+	live.thinking_chars = partial.content.reduce(
+		(n, part) => n + (part.type === "thinking" ? part.thinking.length : 0),
+		0,
+	);
+}
+
+/** Compact text mirror of the live view, for non-TUI clients and print mode. */
+function formatLiveProgress(live: FusionLiveDetails, concurrency: number): string {
+	const lines = [`Fusion ${live.phase} (${concurrency === 1 ? "serialized" : `${concurrency} concurrent`}):`];
+	for (const model of live.panel) lines.push(`  ${liveIcon(model.phase)} ${model.model} — ${liveStatus(model)}`);
+	if (live.judge) lines.push(`  ${liveIcon(live.judge.phase)} judge ${live.judge.model} — ${liveStatus(live.judge)}`);
+	return lines.join("\n");
+}
+
+function liveIcon(phase: FusionLiveModel["phase"]): string {
+	return phase === "done" ? "✓" : phase === "failed" ? "✗" : phase === "running" ? "…" : "·";
+}
+
+function liveStatus(model: FusionLiveModel): string {
+	if (model.error) return `failed: ${model.error}`;
+	const toolNote = model.tools
