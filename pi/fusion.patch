+/**
+ * Render the live streaming view. Text (not markdown) keeps partial, in-flight output
+ * stable and cheap to redraw on every throttled update.
+ */
+function renderLiveProgress(live: FusionLiveDetails, theme: Theme): Text {
+	const lines: string[] = [theme.fg("accent", theme.bold(`Fusion ${live.phase}`))];
+	const modelLine = (model: FusionLiveModel, label = model.model): string => {
+		const icon =
+			model.phase === "done"
+				? theme.fg("success", "✓")
+				: model.phase === "failed"
+					? theme.fg("error", "✗")
+					: model.phase === "running"
+						? theme.fg("warning", "…")
+						: theme.fg("dim", "·");
+		const head = `${icon} ${theme.fg("toolTitle", label)}`;
+		if (model.error) return `${head} ${theme.fg("error", model.error)}`;
+		const bits = [model.phase === "running" ? "streaming" : model.phase];
+		if (model.chars) bits.push(`${model.chars} chars`);
+		if (model.thinking_chars) bits.push(`${model.thinking_chars} thinking`);
+		if (model.tools) bits.push(`${model.tools} tool${model.tools === 1 ? "" : "s"}`);
+		return `${head} ${theme.fg("muted", bits.join(" · "))}`;
+	};
+	for (const model of live.panel) {
+		lines.push(modelLine(model));
+		if (model.preview) {
+			for (const part of model.preview.split("\n").slice(-3)) lines.push(theme.fg("dim", `    ${part}`));
+		}
+	}
+	if (live.judge) lines.push(modelLine(live.judge, `judge ${live.judge.model}`));
+	return new Text(lines.join("\n"), 0, 0);
+}
